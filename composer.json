{
  "name": "lsr/inertia",
  "license": "MIT",
  "description": "Laser framework core - Inertia adapter",
  "version": "0.1.9",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.laserliga.cz"
    }
  ],
  "scripts": {
    "test": "XDEBUG_MODE=coverage ./vendor/bin/phpunit",
    "docs": "doxygen",
    "phpstan": "./vendor/bin/phpstan",
    "cs:fix": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "cbf": "@cs:fix",
    "cs": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^11",
    "phpstan/phpstan": "^2.0",
    "phpstan/extension-installer": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "nette/di": "^3.2",
    "latte/latte": "^3.1",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Lsr\\Inertia\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@wboy.cz"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "psr/http-client": "^1",
    "psr/http-factory": "^1",
    "psr/http-message": "^1|^2",
    "psr/http-server-middleware": "^1",
    "lsr/interfaces": "^0.3.16",
    "symfony/serializer": "^8|^7|^6"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
  }
}
